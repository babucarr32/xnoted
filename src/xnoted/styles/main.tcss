/* ===================
   Layout & Structure
   =================== */

ContentWrapper {
  layout: vertical;
  height: 1fr;
}

Content {
  layout: grid;
  grid-size: 2;
  grid-columns: 1fr 3fr;
  height: 100%;
}

SideBar,
Body {
  height: 100%;
}

/* ===================
   Borders & Containers
   =================== */

CustomHeader {
  text-align: center;
  border: solid $primary;
}

Body,
TaskHeader,
Input,
InputContainer,
RadioSet,
Select,
SelectOverlay,
TextArea,
TaskContainer,
ProjectsModal,
CommandPalettes,
/* FormContainer, */
CopyTask,
SelectProject,
FooterLabel,
#confirm {
  border: round $primary;
}

TaskContainer,
ProjectsModal,
CopyTask,
SelectProject {
  border-title-align: left;
  border-title-style: bold;
}

.box {
  height: 0%;
  border: solid $primary;
}

FooterLabel {
  layout: horizontal;
  width: 100%;
}

FooterLabel>*:first-child {
  width: 1fr;
  content-align: left middle;
}

FooterLabel>*:last-child {
  width: auto;
  content-align: right middle;
  padding-right: 1;
}

/* ===================
   Backgrounds
   =================== */

Tasks,
Input,
Select,
RadioSet,
ProjectsModal,
CommandPalettes,
CopyTask,
SelectProject,
#modal-dialog,
CreateTaskModal Vertical,
SyncConfigModal Vertical,
ImportExportProjectModal Vertical,
CreateProjectModal Vertical {
  background: transparent;
}

SelectOverlay,
TextArea {
  background: transparent !important;
}

/* ===================
   Modals
   =================== */

CreateTaskModal,
SyncConfigModal,
SelectProjectModal,
CopyTaskModal,
CreateProjectModal,
ConfirmModal,
ImportExportProjectModal,
CommandPaletteModal,
CreatePasswordModal,
EditPasswordModal,
EnterPasswordModal,
Confirm {
  align: center middle;
}

#modal-dialog {
  height: auto;
}

#modal-hint {
  width: 100%;
  content-align: center middle;
  color: $text-muted;
  text-style: italic;
}

CreateTaskModal Vertical {
  width: 70%;
  height: 50%;
}

LoadingIndicator {
  width: 3%;
  height: 1%;
}

SyncConfigModal Vertical {
  width: 50%;
  height: 6;
}

CreateProjectModal Vertical,
ProjectsModal,
SelectProject {
  width: 50%;
  height: 50%;
}

CommandPalettes {
  width: 50%;
  height: 70%;
}

CreatePasswordModal Form {
  width: 30%;
  height: 12%;
}

EditPasswordModal EditPasswordForm {
  width: 30%;
  height: 19%;
}

EnterPasswordModal EnterPasswordForm {
  width: 30%;
  height: 3;
}

CopyTask {
  width: 30%;
  height: 7;
}

ImportExportProjectModal Vertical {
  width: 50%;
  height: 7
}

#confirm {
  padding: 0;
  width: 60;
}

/* ===================
   Form Elements
   =================== */

Input,
InputContainer,
RadioSet {
  margin: 0;
}

.toggle--button {
  background: transparent;
}

RadioButton.-on .toggle--button {
  color: $primary;
}

#submit {
  width: 100%;
}

#createTaskLabel {
  margin-bottom: 1;
}

/* ===================
   Scrollbars
   =================== */

VerticalScroll,
TextArea {
  scrollbar-visibility: hidden;
}

Toast {
  background: transparent;
}